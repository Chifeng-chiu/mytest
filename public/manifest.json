{
  "id": "./elder.html",
  "name": "樂活在地通",
  "short_name": "樂活在地通",
  "description": "為在地高齡長輩設計的關懷 Web App：佳儒的叮嚀、老友照片牆、健康步數、社區廣播、老友湊咖與接駁車看板。",
  "lang": "zh-Hant",
  "dir": "ltr",
  "start_url": "./elder.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "orientation": "any",
  "background_color": "#FFFDF7",
  "theme_color": "#15803D",
  "categories": ["lifestyle", "health", "social"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "佳儒的叮嚀",
      "short_name": "叮嚀",
      "description": "查看今天的提醒與回報",
      "url": "./elder.html?view=reminders",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "老友照片牆",
      "short_name": "照片",
      "description": "看看老友的早安照",
      "url": "./elder.html?view=photos",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "健康步數",
      "short_name": "健康",
      "description": "查看步數與樂活金幣",
      "url": "./elder.html?view=health",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "社區廣播站",
      "short_name": "廣播",
      "description": "聽社區最新消息與接駁車到站時間",
      "url": "./elder.html?view=radio",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
